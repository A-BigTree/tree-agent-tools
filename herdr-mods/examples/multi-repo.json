{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [12, 16],
  "background": "canvas",
  "terminal_padding": [14, 12],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": { "px": 280 },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": true,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": { "px": 46 },
          "window_drag": true,
          "content": { "mod": "workspace-chrome" }
        },
        {
          "id": "requirements",
          "type": "block",
          "size": { "weight": 1 },
          "min": 90,
          "content": { "mod": "multi-repo-sidebar" }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": { "px": 42 },
          "window_drag": true,
          "content": { "mod": "tabs" }
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 8,
                  "radius": 10,
                  "background": "background",
                  "lone": true,
                  "border": { "width": 1, "color": "border" },
                  "focus": { "width": 1, "color": "accent" },
                  "header": {
                    "content": { "mod": "pane" },
                    "height": 30,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "size": { "px": 368 },
              "hidden": true,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": { "mod": "files" }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": { "mod": "changes" }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "size": { "px": 28 },
          "content": { "mod": "workspace-status" }
        }
      ]
    }
  ]
}
